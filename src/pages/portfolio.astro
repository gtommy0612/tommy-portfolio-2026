---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    id: 1,
    title: "NovaSaaS 雲端行銷落地頁",
    category: "web",
    tags: ["Astro", "Tailwind CSS", "SEO Optimization"],
    description: "為新創 SaaS 平台打造的高轉化率落地頁。利用 Astro 靜態生成技術與極致的 CSS 優化，實現 100 分的 Lighthouse 載入效能，有效提升註冊率 25%。",
    url: "https://nova-saas-demo.vercel.app",
    typeLabel: "Web Development"
  },
  {
    id: 2,
    title: "Omega 數位品牌視覺識別系統",
    category: "graphic",
    tags: ["Branding", "UI Kit", "Figma"],
    description: "為新一代金融科技 (Fintech) 平台設計的全套品牌視覺系統。包含標誌、色彩體系、排版規範，以及可用於行銷活動的 Figma 模板元件庫。",
    url: "https://figma.com/file/omega-design-system",
    typeLabel: "Graphic Design"
  },
  {
    id: 3,
    title: "EcoEarth 綠色環保電商平台",
    category: "web",
    tags: ["React", "Next.js", "Stripe API"],
    description: "永續環保產品的電子商務平台。採用 Jamstack 架構開發，整合無伺服器金流與靜態產品目錄，提供無縫且安全的手機與桌面端購物體驗。",
    url: "https://eco-earth-store.vercel.app",
    typeLabel: "Web Development"
  },
  {
    id: 4,
    title: "Aether 數位藝術展演海報與推廣設計",
    category: "graphic",
    tags: ["Poster", "Typography", "Illustrator"],
    description: "為 Aether 當代藝術展策劃的宣傳設計。融合科技感與極簡主義，運用強烈對比字型與幾何圖形，傳遞展覽核心「科技與自然的共生」。",
    url: "https://behance.net/gallery/aether-exhibition",
    typeLabel: "Graphic Design"
  },
  {
    id: 5,
    title: "Aurora 個人智慧日誌 App 介面設計",
    category: "graphic",
    tags: ["App Design", "iOS Style", "Figma"],
    description: "一款專注於心靈健康的 AI 日誌 App UI 設計。以圓潤的幾何形狀與療癒色調，打造沉浸、無壓力的介面體驗，包含全套 20+ 的交互畫面。",
    url: "https://dribbble.com/shots/aurora-app",
    typeLabel: "Graphic Design"
  },
  {
    id: 6,
    title: "Pulse 健身數據儀表板系統",
    category: "web",
    tags: ["Next.js", "Chart.js", "TailwindCSS"],
    description: "專為智慧健身房設計的管理後台與數據視覺化面板。整合實時心率、卡路里消耗與會員出席率等多項指標統計圖表。",
    url: "https://pulse-dashboard.vercel.app",
    typeLabel: "Web Development"
  }
];
---

<Layout 
  title="作品集總覽 | Tommy Chen" 
  description="探索 Tommy 的精選專案作品，包含高效靜態網頁、React 應用程式開發、Figma UI 介面設計與品牌視覺識別。"
>
  <!-- Page Header -->
  <section class="py-20 px-6 relative overflow-hidden bg-[#0a0a0c]">
    <!-- Glow -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full bg-brand/10 blur-[120px] pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto text-center space-y-4 relative z-10">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight">作品集總覽</h1>
      <p class="text-muted max-w-xl mx-auto text-base md:text-lg">
        精心打造的網頁專案與視覺設計，兼具極致效能與現代化 UI 體驗。
      </p>
    </div>
  </section>

  <!-- Filter & Grid Section -->
  <section class="py-12 pb-32 px-6">
    <div class="max-w-7xl mx-auto">
      
      <!-- Filter Button Tabs -->
      <div class="flex justify-center items-center space-x-3 mb-16 border-b border-dark-border/40 pb-6">
        <button 
          type="button" 
          data-filter="all" 
          class="filter-btn px-6 py-2.5 rounded-full text-sm font-semibold border transition-all duration-300 cursor-pointer bg-brand border-brand text-white shadow-lg shadow-brand/20"
        >
          全部作品
        </button>
        <button 
          type="button" 
          data-filter="web" 
          class="filter-btn px-6 py-2.5 rounded-full text-sm font-semibold border border-dark-border text-muted hover:text-white hover:border-brand/40 transition-all duration-300 cursor-pointer"
        >
          網頁開發 (Web)
        </button>
        <button 
          type="button" 
          data-filter="graphic" 
          class="filter-btn px-6 py-2.5 rounded-full text-sm font-semibold border border-dark-border text-muted hover:text-white hover:border-brand/40 transition-all duration-300 cursor-pointer"
        >
          平面與介面 (Graphic)
        </button>
      </div>

      <!-- Project Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-grid">
        {projects.map((project) => (
          <div 
            class="project-card group rounded-2xl border border-dark-border bg-dark-card/30 overflow-hidden flex flex-col justify-between hover:border-brand/30 hover:shadow-2xl hover:shadow-brand/5 transition-all duration-500 transform opacity-100 scale-100" 
            data-category={project.category}
          >
            <!-- Visual Mockup Area -->
            <div class="aspect-video relative overflow-hidden bg-dark-card border-b border-dark-border flex items-center justify-center">
              
              <!-- Subtle dynamic backdrop -->
              <div class="absolute inset-0 bg-radial-gradient from-transparent to-black/40 pointer-events-none"></div>

              {project.id === 1 && (
                <!-- NovaSaaS Mock UI -->
                <div class="w-[85%] h-[80%] rounded-lg border border-dark-border bg-dark/95 p-3 shadow-2xl relative overflow-hidden group-hover:scale-105 transition-transform duration-500">
                  <div class="flex items-center space-x-1.5 mb-2 pb-1.5 border-b border-dark-border/60">
                    <div class="w-2 h-2 rounded-full bg-red-500/80"></div>
                    <div class="w-2 h-2 rounded-full bg-yellow-500/80"></div>
                    <div class="w-2 h-2 rounded-full bg-green-500/80"></div>
                    <div class="w-10 h-1.5 bg-dark-card rounded-md ml-2"></div>
                  </div>
                  <div class="space-y-2">
                    <div class="h-3 w-2/3 bg-gradient-to-r from-brand to-cyan-500 rounded-sm"></div>
                    <div class="h-2 w-full bg-dark-card rounded-sm"></div>
                    <div class="h-2 w-[80%] bg-dark-card rounded-sm"></div>
                    <!-- Chart mock -->
                    <div class="flex items-end space-x-1 pt-2 h-10">
                      <div class="w-full h-1/3 bg-brand/40 rounded-sm"></div>
                      <div class="w-full h-2/3 bg-brand/60 rounded-sm"></div>
                      <div class="w-full h-1/2 bg-brand/50 rounded-sm"></div>
                      <div class="w-full h-5/6 bg-brand rounded-sm"></div>
                      <div class="w-full h-2/3 bg-cyan-500/70 rounded-sm"></div>
                    </div>
                  </div>
                </div>
              )}

              {project.id === 2 && (
                <!-- Omega Branding Mock -->
                <div class="w-[80%] h-[80%] rounded-lg border border-dark-border bg-dark/95 flex flex-col items-center justify-center p-4 shadow-2xl relative overflow-hidden group-hover:scale-105 transition-transform duration-500">
                  <div class="absolute -top-10 -left-10 w-24 h-24 rounded-full bg-brand/20 blur-xl"></div>
                  <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-brand to-cyan-400 flex items-center justify-center text-lg font-black text-white shadow-lg mb-2">
                    Ω
                  </div>
                  <div class="h-2 w-16 bg-white rounded-md mb-1"></div>
                  <div class="h-1.5 w-10 bg-muted rounded-sm"></div>
                </div>
              )}

              {project.id === 3 && (
                <!-- EcoEarth Mock Shop -->
                <div class="w-[85%] h-[80%] rounded-lg border border-dark-border bg-dark/95 p-3 shadow-2xl relative overflow-hidden group-hover:scale-105 transition-transform duration-500">
                  <div class="flex justify-between items-center mb-3">
                    <div class="h-2.5 w-8 bg-dark-card rounded-md"></div>
                    <div class="h-2 w-2 rounded-full bg-cyan-400"></div>
                  </div>
                  <div class="grid grid-cols-2 gap-2 h-full">
                    <div class="rounded-md border border-dark-border bg-dark-card/50 p-2 flex flex-col justify-between">
                      <div class="w-8 h-8 rounded bg-gradient-to-tr from-green-500/20 to-emerald-500/40 mx-auto"></div>
                      <div class="h-1.5 w-8 bg-muted/60 rounded-sm mx-auto"></div>
                    </div>
                    <div class="rounded-md border border-dark-border bg-dark-card/50 p-2 flex flex-col justify-between">
                      <div class="w-8 h-8 rounded bg-gradient-to-tr from-green-500/20 to-emerald-500/40 mx-auto"></div>
                      <div class="h-1.5 w-8 bg-muted/60 rounded-sm mx-auto"></div>
                    </div>
                  </div>
                </div>
              )}

              {project.id === 4 && (
                <!-- Aether Poster Mock -->
                <div class="w-[60%] h-[90%] rounded border border-dark-border bg-dark/95 p-3 shadow-2xl relative overflow-hidden flex flex-col justify-between group-hover:scale-105 transition-transform duration-500">
                  <div class="text-[10px] font-extrabold tracking-wider border-b border-dark-border pb-1">AETHER ART</div>
                  <div class="my-auto space-y-2">
                    <div class="text-xl font-black italic tracking-tighter text-brand line-height-none">FUTURE</div>
                    <div class="text-[8px] text-muted tracking-tight">EXHIBITION 2026 / PARIS</div>
                  </div>
                  <div class="h-1 w-full bg-brand"></div>
                </div>
              )}

              {project.id === 5 && (
                <!-- Aurora iOS Screen Mock -->
                <div class="w-[45%] h-[95%] rounded-2xl border-4 border-dark-border bg-dark p-2 shadow-2xl relative overflow-hidden group-hover:scale-105 transition-transform duration-500">
                  <div class="w-8 h-2 bg-dark-border rounded-full mx-auto mb-2"></div>
                  <div class="space-y-1.5">
                    <div class="h-6 rounded-md bg-brand/10 border border-brand/20 p-1 flex items-center justify-between">
                      <div class="w-4 h-1.5 bg-brand rounded-sm"></div>
                      <div class="w-1.5 h-1.5 rounded-full bg-brand"></div>
                    </div>
                    <div class="h-10 rounded-md bg-dark-card border border-dark-border/60 p-1 space-y-1">
                      <div class="w-2/3 h-1 bg-white rounded-sm"></div>
                      <div class="w-full h-1 bg-muted rounded-sm"></div>
                      <div class="w-3/4 h-1 bg-muted rounded-sm"></div>
                    </div>
                  </div>
                </div>
              )}

              {project.id === 6 && (
                <!-- Pulse Dashboard Mock -->
                <div class="w-[85%] h-[80%] rounded-lg border border-dark-border bg-dark/95 p-3 shadow-2xl relative overflow-hidden group-hover:scale-105 transition-transform duration-500">
                  <div class="flex justify-between items-center pb-2 border-b border-dark-border/60 mb-2">
                    <div class="w-8 h-2 bg-dark-card rounded-md"></div>
                    <div class="w-10 h-2 bg-brand/20 rounded-md"></div>
                  </div>
                  <div class="flex justify-center items-center h-12">
                    <!-- Circular chart mock -->
                    <div class="w-10 h-10 rounded-full border-4 border-dark-border border-t-brand animate-pulse relative flex items-center justify-center">
                      <span class="text-[8px] font-bold">78%</span>
                    </div>
                  </div>
                </div>
              )}
            </div>

            <!-- Content Area -->
            <div class="p-6 space-y-5 flex-grow flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-semibold text-brand tracking-wider">{project.typeLabel}</span>
                  <div class="flex space-x-1.5">
                    {project.tags.slice(0, 2).map(tag => (
                      <span class="px-2 py-0.5 rounded bg-dark-border/60 text-[10px] text-muted font-medium">{tag}</span>
                    ))}
                  </div>
                </div>
                <h2 class="text-xl font-bold text-white group-hover:text-brand transition-colors duration-200">
                  {project.title}
                </h2>
                <p class="text-muted text-sm leading-relaxed font-medium">
                  {project.description}
                </p>
              </div>

              <!-- Button with external link tag ↗ -->
              <div class="pt-4 border-t border-dark-border/40">
                <a 
                  href={project.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-flex items-center text-xs font-bold text-white group-hover:text-brand tracking-wider transition-colors"
                >
                  查看線上實體專案
                  <!-- External Link Icon ↗ -->
                  <svg class="w-3.5 h-3.5 ml-1 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Filter Client Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.project-card');

      buttons.forEach(button => {
        button.addEventListener('click', () => {
          const filter = button.getAttribute('data-filter');

          // Update active button styles
          buttons.forEach(btn => {
            btn.classList.remove('bg-brand', 'border-brand', 'text-white', 'shadow-lg', 'shadow-brand/20');
            btn.classList.add('border-dark-border', 'text-muted');
          });
          button.classList.add('bg-brand', 'border-brand', 'text-white', 'shadow-lg', 'shadow-brand/20');
          button.classList.remove('border-dark-border', 'text-muted');

          // Animate cards filtering
          cards.forEach(card => {
            const category = card.getAttribute('data-category');
            
            if (filter === 'all' || category === filter) {
              // Show: fade in
              card.style.display = 'flex';
              // Trigger reflow for transition
              void card.offsetWidth;
              card.classList.remove('opacity-0', 'scale-95');
              card.classList.add('opacity-100', 'scale-100');
            } else {
              // Hide: fade out
              card.classList.remove('opacity-100', 'scale-100');
              card.classList.add('opacity-0', 'scale-95');
              // Wait for CSS animation then set display none
              setTimeout(() => {
                if (card.classList.contains('opacity-0')) {
                  card.style.display = 'none';
                }
              }, 300);
            }
          });
        });
      });
    });
  </script>
</Layout>
